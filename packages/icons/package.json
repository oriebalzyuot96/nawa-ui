{
  "name": "@orca-ui/icons",
  "version": "0.1.0",
  "description": "Orca Icons: 239 original, accessible SVG icons in outline and duotone (plus solid) for React, Vue, Svelte, Angular, Astro, React Native, Web Components and plain SVG sprites.",
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/element.js"
  ],
  "main": "./dist/icons.js",
  "module": "./dist/icons.js",
  "types": "./dist/icons.d.ts",
  "exports": {
    ".": {
      "types": "./dist/icons.d.ts",
      "default": "./dist/icons.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "default": "./dist/vue/index.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "svelte": "./dist/svelte/index.js",
      "default": "./dist/svelte/index.js"
    },
    "./svelte/Icon.svelte": {
      "types": "./dist/svelte/index.d.ts",
      "svelte": "./dist/svelte/Icon.svelte"
    },
    "./angular": {
      "types": "./dist/angular/index.d.ts",
      "default": "./dist/angular/index.js"
    },
    "./astro": {
      "types": "./dist/astro/index.d.ts",
      "default": "./dist/astro/Icon.astro"
    },
    "./react-native": {
      "types": "./dist/react-native/index.d.ts",
      "default": "./dist/react-native/index.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "default": "./dist/element.js"
    },
    "./icons/*": {
      "types": "./dist/icons/*.d.ts",
      "default": "./dist/icons/*.js"
    },
    "./sprite.svg": "./dist/sprite.svg",
    "./css": "./dist/orca-icons.css",
    "./orca-icons.css": "./dist/orca-icons.css",
    "./json": "./dist/icons.json",
    "./icons.json": "./dist/icons.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node --test test/*.test.mjs",
    "typecheck": "node scripts/build.mjs && tsc -p tsconfig.json",
    "preview": "node scripts/build.mjs && node scripts/preview.mjs",
    "preview:png": "node scripts/build.mjs && node scripts/preview.mjs && node scripts/screenshot.mjs",
    "check:angular": "node test/angular-jit.check.mjs",
    "prepublishOnly": "node scripts/build.mjs && node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@angular/core": ">=17.0.0",
    "astro": ">=4.0.0",
    "react": ">=16.8.0",
    "react-native-svg": ">=13.0.0",
    "svelte": ">=5.0.0",
    "vue": ">=3.3.0"
  },
  "peerDependenciesMeta": {
    "@angular/core": { "optional": true },
    "astro": { "optional": true },
    "react": { "optional": true },
    "react-native-svg": { "optional": true },
    "svelte": { "optional": true },
    "vue": { "optional": true }
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "icons",
    "svg-icons",
    "duotone-icons",
    "react-icons",
    "vue-icons",
    "svelte-icons",
    "angular-icons",
    "icon-library",
    "orca-ui",
    "accessible"
  ],
  "homepage": "https://oriebalzyuot96.github.io/orca-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oriebalzyuot96/orca-ui.git",
    "directory": "packages/icons"
  },
  "bugs": {
    "url": "https://github.com/oriebalzyuot96/orca-ui/issues"
  },
  "author": "oriebalzyuot96",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
