{
  "name": "@orca-ui/three",
  "version": "0.1.0",
  "description": "Orca UI WebGL 3D for React — accessible, theme-aware Three.js components (Scene3D, Globe3D, ParticlesField, FloatingShapes, ModelViewer, Chart3D) with reduced-motion, off-screen pausing and static fallbacks.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "three": ">=0.160.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.170.0",
    "jsdom": "25.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.170.0",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  },
  "keywords": [
    "react",
    "three",
    "threejs",
    "3d",
    "webgl",
    "accessible",
    "accessibility",
    "a11y",
    "globe",
    "particles",
    "gltf",
    "3d-chart",
    "orca-ui",
    "ui-library",
    "component-library",
    "reduced-motion"
  ],
  "homepage": "https://oriieebgsmile96.github.io/orca-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oriieebgSmile96/orca-ui.git",
    "directory": "packages/three"
  },
  "bugs": "https://github.com/oriieebgSmile96/orca-ui/issues",
  "author": "oriieebgSmile96",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
