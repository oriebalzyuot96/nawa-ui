{
  "name": "pelagic",
  "version": "0.2.0",
  "description": "Pelagic UI in one package: 150+ accessible, themeable components for React, Vue, Angular, Svelte, Astro and React Native, plus charts, 3D, icons, illustrations, motion and sound. WCAG 2.2 AA, 21 themes, custom brand colors, RTL.",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "*.css",
    "./dist/astro/**",
    "./dist/icons/dist/element*",
    "./dist/illustrations/dist/element*"
  ],
  "scripts": {
    "build": "node ../../scripts/build-umbrella.mjs",
    "prepublishOnly": "node ../../scripts/build-umbrella.mjs"
  },
  "keywords": [
    "pelagic-ui",
    "ui-library",
    "component-library",
    "design-system",
    "react",
    "vue",
    "angular",
    "svelte",
    "astro",
    "react-native",
    "accessible",
    "accessibility",
    "wcag",
    "a11y",
    "themes",
    "dark-mode",
    "charts",
    "datatable",
    "icons",
    "skeleton",
    "rtl",
    "arabic",
    "primeng-alternative"
  ],
  "homepage": "https://oriebalzyuot96.github.io/pelagic-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oriebalzyuot96/pelagic-ui.git",
    "directory": "packages/pelagic"
  },
  "bugs": "https://github.com/oriebalzyuot96/pelagic-ui/issues",
  "author": "oriebalzyuot96",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./style.css": "./dist/core/pelagic.css",
    "./package.json": "./package.json",
    "./core/style.css": "./dist/core/pelagic.css",
    "./core/pelagic.css": "./dist/core/pelagic.css",
    "./core/tokens": {
      "types": "./dist/core/tokens.d.ts",
      "default": "./dist/core/tokens.js"
    },
    "./core/themes": "./dist/core/src/themes.mjs",
    "./core/a11y": {
      "types": "./dist/core/src/a11y.d.ts",
      "default": "./dist/core/src/a11y.js"
    },
    "./core/theme": {
      "types": "./dist/core/src/theme.d.ts",
      "default": "./dist/core/src/theme.js"
    },
    "./core/a11y-prefs": {
      "types": "./dist/core/src/a11y-prefs.d.ts",
      "default": "./dist/core/src/a11y-prefs.js"
    },
    "./core/fonts/*": "./dist/core/fonts/*",
    "./core/fonts.css": "./dist/core/fonts/atkinson-hyperlegible.css",
    "./core/sound": {
      "types": "./dist/core/src/sound.d.ts",
      "default": "./dist/core/src/sound.js"
    },
    "./core/motion": {
      "types": "./dist/core/src/motion.d.ts",
      "default": "./dist/core/src/motion.js"
    },
    "./core/toast": {
      "types": "./dist/core/src/toast.d.ts",
      "default": "./dist/core/src/toast.js"
    },
    "./react": {
      "types": "./dist/react/dist/index.d.ts",
      "import": "./dist/react/dist/index.js"
    },
    "./vue": {
      "types": "./dist/vue/dist/index.d.ts",
      "import": "./dist/vue/dist/index.js"
    },
    "./svelte": {
      "svelte": "./dist/svelte/src/lib/index.ts",
      "types": "./dist/svelte/src/lib/index.ts",
      "default": "./dist/svelte/src/lib/index.ts"
    },
    "./astro/components/*": "./dist/astro/src/components/*.astro",
    "./angular": {
      "types": "./dist/angular/types/pelagic-ui-angular.d.ts",
      "default": "./dist/angular/fesm2022/pelagic-ui-angular.mjs"
    },
    "./react-native": "./dist/react-native/src/index.ts",
    "./three": {
      "types": "./dist/three/dist/index.d.ts",
      "import": "./dist/three/dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons/dist/icons.d.ts",
      "default": "./dist/icons/dist/icons.js"
    },
    "./icons/react": {
      "types": "./dist/icons/dist/react/index.d.ts",
      "default": "./dist/icons/dist/react/index.js"
    },
    "./icons/vue": {
      "types": "./dist/icons/dist/vue/index.d.ts",
      "default": "./dist/icons/dist/vue/index.js"
    },
    "./icons/svelte": {
      "types": "./dist/icons/dist/svelte/index.d.ts",
      "svelte": "./dist/icons/dist/svelte/index.js",
      "default": "./dist/icons/dist/svelte/index.js"
    },
    "./icons/svelte/Icon.svelte": {
      "types": "./dist/icons/dist/svelte/index.d.ts",
      "svelte": "./dist/icons/dist/svelte/Icon.svelte"
    },
    "./icons/angular": {
      "types": "./dist/icons/dist/angular/index.d.ts",
      "default": "./dist/icons/dist/angular/index.js"
    },
    "./icons/astro": {
      "types": "./dist/icons/dist/astro/index.d.ts",
      "default": "./dist/icons/dist/astro/Icon.astro"
    },
    "./icons/react-native": {
      "types": "./dist/icons/dist/react-native/index.d.ts",
      "default": "./dist/icons/dist/react-native/index.js"
    },
    "./icons/element": {
      "types": "./dist/icons/dist/element.d.ts",
      "default": "./dist/icons/dist/element.js"
    },
    "./icons/icons/*": {
      "types": "./dist/icons/dist/icons/*.d.ts",
      "default": "./dist/icons/dist/icons/*.js"
    },
    "./icons/sprite.svg": "./dist/icons/dist/sprite.svg",
    "./icons/css": "./dist/icons/dist/pelagic-icons.css",
    "./icons/pelagic-icons.css": "./dist/icons/dist/pelagic-icons.css",
    "./icons/json": "./dist/icons/dist/icons.json",
    "./icons/icons.json": "./dist/icons/dist/icons.json",
    "./illustrations": {
      "types": "./dist/illustrations/dist/illustrations.d.ts",
      "default": "./dist/illustrations/dist/illustrations.js"
    },
    "./illustrations/react": {
      "types": "./dist/illustrations/dist/react.d.ts",
      "default": "./dist/illustrations/dist/react.js"
    },
    "./illustrations/vue": {
      "types": "./dist/illustrations/dist/vue.d.ts",
      "default": "./dist/illustrations/dist/vue.js"
    },
    "./illustrations/svelte": {
      "types": "./dist/illustrations/dist/svelte/index.d.ts",
      "svelte": "./dist/illustrations/dist/svelte/index.js",
      "default": "./dist/illustrations/dist/svelte/index.js"
    },
    "./illustrations/svelte/Illustration.svelte": "./dist/illustrations/dist/svelte/Illustration.svelte",
    "./illustrations/astro": "./dist/illustrations/dist/astro/Illustration.astro",
    "./illustrations/astro/Illustration.astro": "./dist/illustrations/dist/astro/Illustration.astro",
    "./illustrations/angular": {
      "types": "./dist/illustrations/dist/angular.d.ts",
      "default": "./dist/illustrations/dist/angular.js"
    },
    "./illustrations/element": {
      "types": "./dist/illustrations/dist/element.d.ts",
      "default": "./dist/illustrations/dist/element.js"
    },
    "./illustrations/native": {
      "types": "./dist/illustrations/dist/native.d.ts",
      "default": "./dist/illustrations/dist/native.js"
    },
    "./illustrations/svg/*": "./dist/illustrations/dist/svg/*"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@angular/common": "^20.0.0 || ^21.0.0 || ^22.0.0",
    "@angular/core": ">=17.0.0",
    "@angular/forms": "^20.0.0 || ^21.0.0 || ^22.0.0",
    "astro": ">=4.0.0",
    "react": ">=18.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-native": ">=0.74.0",
    "react-native-svg": ">=13.0.0",
    "svelte": ">=5.0.0",
    "three": ">=0.160.0",
    "vue": ">=3.3.0"
  },
  "peerDependenciesMeta": {
    "@angular/common": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "@angular/forms": {
      "optional": true
    },
    "astro": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "three": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  }
}
