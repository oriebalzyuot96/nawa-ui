---
// Native <dialog>: focus containment, Escape and an inert background come from the browser.
// Open it with any element carrying data-pl-open="<dialog id>"; close with data-pl-close.
interface Props {
  id: string;
  title: string;
  size?: 'sm' | 'md' | 'lg';
}

const { id, title, size = 'md' } = Astro.props;
const titleId = `${id}-title`;
---

<dialog id={id} class:list={['pl-dialog', size !== 'md' && `pl-dialog--${size}`]} aria-labelledby={titleId}>
  <div class="pl-dialog__header">
    <h2 id={titleId} class="pl-dialog__title">{title}</h2>
    <button type="button" class="pl-close" aria-label="Close" data-pl-close>×</button>
  </div>
  <div class="pl-dialog__body"><slot /></div>
  {Astro.slots.has('footer') && <div class="pl-dialog__footer"><slot name="footer" /></div>}
</dialog>

<script>
  import '../client/overlay';
</script>
