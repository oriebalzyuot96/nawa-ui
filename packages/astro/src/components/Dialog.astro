---
// Native <dialog>: focus containment, Escape and an inert background come from the browser.
// Open it with any element carrying data-nw-open="<dialog id>"; close with data-nw-close.
interface Props {
  id: string;
  title: string;
  size?: 'sm' | 'md' | 'lg';
}

const { id, title, size = 'md' } = Astro.props;
const titleId = `${id}-title`;
---

<dialog id={id} class:list={['nw-dialog', size !== 'md' && `nw-dialog--${size}`]} aria-labelledby={titleId}>
  <header class="nw-dialog__header">
    <h2 id={titleId} class="nw-dialog__title">{title}</h2>
    <button type="button" class="nw-close" aria-label="Close" data-nw-close>×</button>
  </header>
  <div class="nw-dialog__body"><slot /></div>
  {Astro.slots.has('footer') && <footer class="nw-dialog__footer"><slot name="footer" /></footer>}
</dialog>

<script>
  import '../client/overlay';
</script>
