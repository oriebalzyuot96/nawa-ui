---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'button'> {
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost' | 'danger';
  size?: 'sm' | 'md' | 'lg';
  block?: boolean;
  iconOnly?: boolean;
  loading?: boolean;
  type?: 'button' | 'submit' | 'reset';
}

const { variant = 'primary', size = 'md', block = false, iconOnly = false, loading = false, type = 'button', ...rest } = Astro.props;
---

<button
  type={type}
  class:list={['nw-btn', `nw-btn--${variant}`, size !== 'md' && `nw-btn--${size}`, block && 'nw-btn--block', iconOnly && 'nw-btn--icon']}
  disabled={loading || rest.disabled}
  aria-busy={loading ? 'true' : undefined}
  {...rest}
>
  {loading && <span class="nw-spinner" aria-hidden="true"></span>}
  <slot />
</button>
