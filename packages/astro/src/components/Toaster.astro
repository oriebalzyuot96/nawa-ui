---
// Notification region shared with every Pelagic package (@pelagic-ui/core/toast). Place once per page,
// then call from any client script:
//   window.pelagicToast({ title: 'Saved', message: 'Your changes are live', variant: 'success' })
//   window.pelagicToaster.promise(fetch('/api'), { loading: 'Saving…', success: 'Saved', error: 'Failed' })
// Spring enter and exit, a deck that fans out on hover or focus, swipe to dismiss, pausing countdowns,
// animated icons, actions and undo, polite / assertive announcements, RTL; fades only under reduced motion.
interface Props {
  position?: 'top-start' | 'top-center' | 'top-end' | 'bottom-start' | 'bottom-center' | 'bottom-end';
  visibleToasts?: number;
  /** Default auto-dismiss delay in ms. */
  duration?: number;
  expand?: boolean;
  richColors?: boolean;
  closeButton?: boolean;
  progress?: boolean;
  locale?: string;
  dir?: 'ltr' | 'rtl' | 'auto';
}
const { position = 'bottom-end', visibleToasts = 3, duration = 5000, expand = false, richColors = false, closeButton = true, progress = false, locale, dir } = Astro.props;
const config = JSON.stringify({ position, visibleToasts, duration, expand, richColors, closeButton, progress, locale, dir });
---

<template data-pl-toaster data-config={config}></template>

<script>
  import '../client/toast';
</script>
