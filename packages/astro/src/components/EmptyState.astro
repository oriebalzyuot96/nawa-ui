---
/**
 * Illustrated empty state.
 * Illustration: `illustration="no-results"` (renders <oc-illustration>; register it with
 * `import '@orca-ui/illustrations/element'`) or the `illustration` slot, e.g.
 * `<Illustration slot="illustration" name="no-results" />` from @orca-ui/illustrations/astro.
 * Slots: illustration, icon (legacy), primary, secondary, action (legacy), actions.
 */
interface Props {
  title: string;
  description?: string;
  illustration?: string | false;
  size?: 'compact' | 'default' | 'page';
  align?: 'center' | 'start';
  /** `split` puts the illustration beside the text when the component is ≥ 36rem wide. */
  layout?: 'stack' | 'split';
  tone?: 'neutral' | 'info' | 'success' | 'warning' | 'danger';
  /** Heading level for the title (default 3); `false` renders a paragraph. */
  headingLevel?: 1 | 2 | 3 | 4 | 5 | 6 | false;
  class?: string;
}

const {
  title,
  description,
  illustration,
  size = 'default',
  align = 'center',
  layout = 'stack',
  tone,
  headingLevel = 3,
  class: className,
} = Astro.props;
const Heading = (headingLevel ? `h${headingLevel}` : 'p') as 'h3';
const hasSlotIllustration = Astro.slots.has('illustration');
const hasActions = ['primary', 'secondary', 'action', 'actions'].some((s) => Astro.slots.has(s));
const classes = [
  'oc-empty',
  size !== 'default' && `oc-empty--${size}`,
  align === 'start' && 'oc-empty--start',
  layout === 'split' && 'oc-empty--split',
  tone && `oc-empty--tone-${tone}`,
  className,
].filter(Boolean);
---

<div class:list={classes}>
  <div class="oc-empty__inner">
    {hasSlotIllustration ? (
      <div class="oc-empty__media"><slot name="illustration" /></div>
    ) : typeof illustration === 'string' && illustration ? (
      <div class="oc-empty__media"><oc-illustration name={illustration} compact={size === 'compact' ? '' : undefined}></oc-illustration></div>
    ) : null}
    {Astro.slots.has('icon') && <div class="oc-empty__icon" aria-hidden="true"><slot name="icon" /></div>}
    <div class="oc-empty__body">
      <Heading class="oc-empty__title">{title}</Heading>
      {description && <p class="oc-empty__desc">{description}</p>}
      {hasActions && (
        <div class="oc-empty__actions oc-empty__action"><slot name="primary" /><slot name="secondary" /><slot name="actions" /><slot name="action" /></div>
      )}
    </div>
  </div>
</div>
