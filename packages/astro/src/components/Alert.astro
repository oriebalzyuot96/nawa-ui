---
interface Props {
  variant?: 'info' | 'success' | 'warning' | 'danger';
  title?: string;
}

const { variant = 'info', title } = Astro.props;
const urgent = variant === 'danger' || variant === 'warning';
---

<div role={urgent ? 'alert' : 'status'} class:list={['oc-alert', variant !== 'info' && `oc-alert--${variant}`]}>
  <div class="oc-alert__body">
    {title && <div class="oc-alert__title">{title}</div>}
    <slot />
  </div>
</div>
