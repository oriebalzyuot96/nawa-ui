---
interface Option {
  label: string;
  value: string;
  disabled?: boolean;
}

interface Props {
  name: string;
  options: Option[];
  value?: string;
  /** Visible group label (rendered as a fieldset legend). */
  label?: string;
}

const { name, options, value, label } = Astro.props;
---

<fieldset class="pl-radio-group" style="border: 0; margin: 0; padding: 0; min-inline-size: 0;">
  {label && <legend class="pl-label" style="padding: 0; margin-bottom: 0.375rem;">{label}</legend>}
  {options.map((o) => (
    <label class:list={['pl-check', o.disabled && 'pl-check--disabled']}>
      <input type="radio" name={name} value={o.value} checked={o.value === value} disabled={o.disabled} />
      {o.label}
    </label>
  ))}
</fieldset>
