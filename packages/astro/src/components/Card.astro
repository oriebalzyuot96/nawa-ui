---
interface Props {
  title?: string;
}

const { title } = Astro.props;
const hasFooter = Astro.slots.has('footer');
---

<article class="pl-card">
  {title && <header class="pl-card__header">{title}</header>}
  <div class="pl-card__body"><slot /></div>
  {hasFooter && <footer class="pl-card__footer"><slot name="footer" /></footer>}
</article>
