---
// Side panel on a native <dialog>. Open with data-pl-open="<id>"; close with data-pl-close.
interface Props {
  id: string;
  title: string;
  side?: 'left' | 'right';
}

const { id, title, side = 'right' } = Astro.props;
const titleId = `${id}-title`;
---

<dialog id={id} class:list={['pl-drawer', side === 'right' ? 'pl-drawer--right' : 'pl-drawer--left']} aria-labelledby={titleId}>
  <div class="pl-dialog__header">
    <h2 id={titleId} class="pl-dialog__title">{title}</h2>
    <button type="button" class="pl-close" aria-label="Close" data-pl-close>×</button>
  </div>
  <div class="pl-dialog__body"><slot /></div>
  {Astro.slots.has('footer') && <div class="pl-dialog__footer"><slot name="footer" /></div>}
</dialog>

<script>
  import '../client/overlay';
</script>
