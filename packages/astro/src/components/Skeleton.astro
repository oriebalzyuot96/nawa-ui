---
interface Props {
  width?: number | string;
  height?: number | string;
  circle?: boolean;
}

const { width, height, circle = false } = Astro.props;
const css = (v?: number | string) => (typeof v === 'number' ? `${v}px` : v);
const w = circle ? (height ?? width) : width;
---

<span aria-hidden="true" class:list={['nw-skeleton', circle && 'nw-skeleton--circle']} style={`${w !== undefined ? `width:${css(w)};` : ''}${height !== undefined ? `height:${css(height)};` : ''}`}></span>
