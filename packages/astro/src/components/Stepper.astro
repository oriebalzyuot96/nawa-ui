---
interface Step {
  label: string;
  description?: string;
}

interface Props {
  steps: Step[];
  /** Zero-based index of the active step. */
  current?: number;
}

const { steps, current = 0 } = Astro.props;
---

<ol class="pl-stepper">
  {steps.map((s, i) => {
    const state = i < current ? 'complete' : i === current ? 'current' : 'upcoming';
    return (
      <li class="pl-stepper__step" data-state={state} aria-current={state === 'current' ? 'step' : undefined}>
        <span>{s.label}</span>
        {s.description && <span class="pl-stepper__desc">{s.description}</span>}
      </li>
    );
  })}
</ol>
