---
// Native <details>/<summary>: works with zero JavaScript and is keyboard accessible.
interface Item {
  title: string;
  /** Plain text panel content. Use a framework island for rich content. */
  content: string;
  /** Render expanded. */
  open?: boolean;
}

interface Props {
  items: Item[];
  /** Keep the accordion as one group: opening an item closes the others (browser support: Chrome 120+, Firefox 130+, Safari 17.2+). */
  exclusive?: boolean;
}

const { items, exclusive = false } = Astro.props;
---

<div class="pl-accordion" data-pl-exclusive={exclusive ? '' : undefined}>
  {items.map((item) => (
    <details class="pl-accordion__item" open={item.open} name={exclusive ? 'pl-accordion' : undefined}>
      <summary class="pl-accordion__trigger">
        {item.title}
        <span class="pl-accordion__icon" aria-hidden="true">▾</span>
      </summary>
      <div class="pl-accordion__panel">{item.content}</div>
    </details>
  ))}
</div>

<style is:global>
  details.pl-accordion__item > summary { list-style: none; }
  details.pl-accordion__item > summary::-webkit-details-marker { display: none; }
  details.pl-accordion__item[open] .pl-accordion__icon { transform: rotate(180deg); }
</style>
