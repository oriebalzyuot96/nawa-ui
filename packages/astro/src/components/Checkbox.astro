---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'input'> {
  label?: string;
  disabled?: boolean;
  checked?: boolean;
}

const { label, disabled = false, checked = false, ...rest } = Astro.props;
---

<label class:list={['oc-check', disabled && 'oc-check--disabled']}>
  <input type="checkbox" checked={checked} disabled={disabled} {...rest} />
  {label}<slot />
</label>
