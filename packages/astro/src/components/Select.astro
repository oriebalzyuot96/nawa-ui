---
import type { HTMLAttributes } from 'astro/types';

interface Option {
  label: string;
  value: string;
  disabled?: boolean;
}

interface Props extends HTMLAttributes<'select'> {
  label?: string;
  hint?: string;
  error?: string;
  options?: Option[];
  placeholder?: string;
  value?: string;
}

const { label, hint, error, options = [], placeholder, value, id, class: className, ...rest } = Astro.props;
const selectId = id ?? `pl-select-${Math.random().toString(36).slice(2, 8)}`;
const describedBy = error ? `${selectId}-err` : hint ? `${selectId}-hint` : undefined;
---

<div class:list={['pl-field', error && 'pl-field--error']}>
  {label && <label class="pl-label" for={selectId}>{label}</label>}
  <select id={selectId} class:list={['pl-select', className]} aria-invalid={error ? 'true' : undefined} aria-describedby={describedBy} {...rest}>
    {placeholder && <option value="">{placeholder}</option>}
    {options.map((o) => (
      <option value={o.value} selected={o.value === value} disabled={o.disabled}>{o.label}</option>
    ))}
    <slot />
  </select>
  {error ? <span id={`${selectId}-err`} class="pl-error-text">{error}</span> : hint ? <span id={`${selectId}-hint`} class="pl-hint">{hint}</span> : null}
</div>
