---
// Paragraph placeholder. The last line is shorter. Announced once as a loading status.
interface Props {
  lines?: number;
  label?: string;
}

const { lines = 3, label = 'Loading…' } = Astro.props;
---

<div role="status" aria-busy="true" class="oc-skeleton-text">
  <span class="oc-sr-only">{label}</span>
  {Array.from({ length: lines }, () => <span class="oc-skeleton" aria-hidden="true" style="height:12px"></span>)}
</div>
