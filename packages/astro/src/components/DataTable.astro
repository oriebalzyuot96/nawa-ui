---
// Server-rendered table. Sorting happens on the server: pass `sort` (e.g. from the URL)
// and `sortHref` so sortable headers become links like `?sort={key}&dir={dir}`.
interface Column {
  key: string;
  label: string;
  sortable?: boolean;
  align?: 'start' | 'center' | 'end';
}

interface Props {
  columns: Column[];
  rows: Record<string, unknown>[];
  /** Accessible name of the table. Hidden visually unless `captionVisible`. */
  caption?: string;
  captionVisible?: boolean;
  emptyMessage?: string;
  sort?: { key: string; direction: 'asc' | 'desc' };
  /** URL template for sort links; `{key}` and `{dir}` are replaced. */
  sortHref?: string;
}

const { columns, rows, caption, captionVisible = false, emptyMessage = 'No data', sort, sortHref } = Astro.props;

const compare = (a: unknown, b: unknown) => {
  if (a == null && b == null) return 0;
  if (a == null) return 1;
  if (b == null) return -1;
  if (typeof a === 'number' && typeof b === 'number') return a - b;
  return String(a).localeCompare(String(b), undefined, { numeric: true, sensitivity: 'base' });
};
const sorted = sort ? [...rows].sort((x, y) => (sort.direction === 'asc' ? 1 : -1) * compare(x[sort.key], y[sort.key])) : rows;
const alignClass = (align?: Column['align']) => (align === 'end' ? 'oc-table__align-end' : align === 'center' ? 'oc-table__align-center' : undefined);
const nextDir = (key: string) => (sort?.key === key && sort.direction === 'asc' ? 'desc' : 'asc');
const arrow = (key: string) => (sort?.key === key ? (sort.direction === 'asc' ? '▲' : '▼') : '↕');
---

<div class="oc-table-wrap" data-responsive="stack">
  <table class="oc-table">
    {caption && <caption class={captionVisible ? undefined : 'oc-sr-only'}>{caption}</caption>}
    <thead>
      <tr>
        {columns.map((col) => (
          <th
            scope="col"
            class={alignClass(col.align)}
            aria-sort={col.sortable && sort?.key === col.key ? (sort.direction === 'asc' ? 'ascending' : 'descending') : undefined}
          >
            {col.sortable && sortHref ? (
              <a class="oc-table__sort" href={sortHref.replace('{key}', col.key).replace('{dir}', nextDir(col.key))}>
                {col.label} <span aria-hidden="true">{arrow(col.key)}</span>
              </a>
            ) : (
              col.label
            )}
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {sorted.length === 0 ? (
        <tr>
          <td class="oc-table__empty" colspan={columns.length}>{emptyMessage}</td>
        </tr>
      ) : (
        sorted.map((row) => (
          <tr>
            {columns.map((col) => (
              <td class={alignClass(col.align)} data-label={col.label}>{String(row[col.key] ?? '')}</td>
            ))}
          </tr>
        ))
      )}
    </tbody>
  </table>
</div>
