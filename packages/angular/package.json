{
  "name": "@orca-ui/angular",
  "version": "0.1.0",
  "description": "Orca UI for Angular — accessible, themeable standalone components built on signals (DataTable, Dialog, Tabs, Skeleton, Toast and more). WCAG 2.2 AA, 21 themes, RTL.",
  "scripts": {
    "build": "ng build orca-ui",
    "test": "ng test orca-ui --watch=false",
    "typecheck": "ngc -p tsconfig.lib.json --noEmit && ngc -p tsconfig.spec.json --noEmit"
  },
  "peerDependencies": {
    "@angular/common": "^20.0.0 || ^21.0.0 || ^22.0.0",
    "@angular/core": "^20.0.0 || ^21.0.0 || ^22.0.0",
    "@angular/forms": "^20.0.0 || ^21.0.0 || ^22.0.0"
  },
  "dependencies": {
    "@orca-ui/core": "0.1.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/compiler-cli": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/forms": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "jsdom": "27.0.1",
    "ng-packagr": "22.2.4",
    "rxjs": "7.8.2",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "keywords": [
    "angular",
    "angular-components",
    "angular-ui",
    "angular-signals",
    "standalone-components",
    "orca-ui",
    "ui-library",
    "component-library",
    "design-system",
    "accessible",
    "accessibility",
    "wcag",
    "a11y",
    "themes",
    "dark-mode",
    "skeleton",
    "datatable",
    "rtl",
    "arabic",
    "primeng-alternative"
  ],
  "homepage": "https://oriebalzyuot96.github.io/orca-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oriebalzyuot96/orca-ui.git",
    "directory": "packages/angular"
  },
  "bugs": "https://github.com/oriebalzyuot96/orca-ui/issues",
  "author": "oriebalzyuot96",
  "publishConfig": {
    "access": "public"
