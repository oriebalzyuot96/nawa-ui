{
  "name": "@orca-ui/vue",
  "version": "0.1.0",
  "description": "Orca UI for Vue 3 — accessible, themeable component library (DataTable, Dialog, Tabs, Skeleton, Toast and more). WCAG 2.2 AA, 21 themes, RTL.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@orca-ui/core": "0.1.0"
  },
  "devDependencies": {
    "@vue/test-utils": "2.4.6",
    "axe-core": "4.10.3",
    "jsdom": "25.0.1",
    "typescript": "5.6.3",
    "vitest": "2.1.8",
    "vue": "3.5.13"
  },
  "keywords": [
    "vue",
    "vue3",
    "vue-components",
    "vue-ui",
    "orca-ui",
    "ui-library",
    "component-library",
    "design-system",
    "accessible",
    "accessibility",
    "wcag",
    "a11y",
    "themes",
    "dark-mode",
    "skeleton",
    "datatable",
    "rtl",
    "arabic",
    "primeng-alternative"
  ],
  "homepage": "https://oriebalzyuot96.github.io/orca-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oriebalzyuot96/orca-ui.git",
    "directory": "packages/vue"
  },
  "bugs": "https://github.com/oriebalzyuot96/orca-ui/issues",
  "author": "oriebalzyuot96",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
