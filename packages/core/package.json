{
  "name": "@orca-ui/core",
  "version": "0.1.0",
  "description": "Orca UI core: accessible design tokens, 21 color themes (light, dark, high contrast × 7 accents) and framework-agnostic CSS.",
  "type": "module",
  "files": [
    "orca-ui.css",
    "tokens.js",
    "tokens.d.ts",
    "src/themes.mjs",
    "src/a11y.js",
    "src/a11y.d.ts",
    "src/theme.js",
    "src/theme.d.ts",
    "src/motion.js",
    "src/motion.d.ts",
    "src/sound.js",
    "src/sound.d.ts",
    "src/a11y-prefs.js",
    "src/a11y-prefs.d.ts",
    "fonts",
    "README.md"
  ],
  "style": "orca-ui.css",
  "main": "tokens.js",
  "types": "tokens.d.ts",
  "exports": {
    "./style.css": "./orca-ui.css",
    "./orca-ui.css": "./orca-ui.css",
    "./tokens": {
      "types": "./tokens.d.ts",
      "default": "./tokens.js"
    },
    "./themes": "./src/themes.mjs",
    "./a11y": {
      "types": "./src/a11y.d.ts",
      "default": "./src/a11y.js"
    },
    "./theme": {
      "types": "./src/theme.d.ts",
      "default": "./src/theme.js"
    },
    "./a11y-prefs": {
      "types": "./src/a11y-prefs.d.ts",
      "default": "./src/a11y-prefs.js"
    },
    "./fonts/*": "./fonts/*",
    "./fonts.css": "./fonts/atkinson-hyperlegible.css",
    "./sound": {
      "types": "./src/sound.d.ts",
      "default": "./src/sound.js"
    },
    "./motion": {
      "types": "./src/motion.d.ts",
      "default": "./src/motion.js"
    }
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "prepublishOnly": "node scripts/build.mjs && node scripts/check-contrast.mjs",
    "test:contrast": "node scripts/check-contrast.mjs"
  },
  "keywords": [
    "orca-ui",
    "ui-library",
    "design-system",
    "design-tokens",
    "css",
    "themes",
    "dark-mode",
    "accessibility",
    "wcag",
    "a11y",
    "rtl",
    "arabic"
  ],
  "homepage": "https://oriebalzyuot96.github.io/orca-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oriebalzyuot96/orca-ui.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/oriebalzyuot96/orca-ui/issues",
  "author": "oriebalzyuot96",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "devDependencies": {
    "jsdom": "25.0.1",
    "vitest": "2.1.8"
  }
}
