{
  "name": "@orca-ui/svelte",
  "version": "0.1.0",
  "description": "Orca UI for Svelte 5 — accessible, themeable component library. WCAG 2.2 AA, 21 themes, RTL.",
  "type": "module",
  "svelte": "src/lib/index.ts",
  "types": "src/lib/index.ts",
  "exports": {
    ".": {
      "svelte": "./src/lib/index.ts",
      "types": "./src/lib/index.ts",
      "default": "./src/lib/index.ts"
    }
  },
  "files": [
    "src/lib",
    "README.md"
  ],
  "scripts": {
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "@orca-ui/core": "0.1.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/svelte": "5.2.8",
    "@testing-library/user-event": "14.5.2",
    "jsdom": "25.0.1",
    "svelte": "5.16.0",
    "svelte-check": "4.1.1",
    "typescript": "5.6.3",
    "vitest": "3.2.4"
  },
  "keywords": [
    "svelte",
    "svelte5",
    "svelte-components",
    "svelte-ui",
    "orca-ui",
    "ui-library",
    "component-library",
    "design-system",
    "accessible",
    "accessibility",
    "wcag",
    "a11y",
    "themes",
    "dark-mode",
    "skeleton",
    "datatable",
    "rtl",
    "arabic",
    "primeng-alternative"
  ],
  "homepage": "https://oriebalzyuot96.github.io/orca-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oriebalzyuot96/orca-ui.git",
    "directory": "packages/svelte"
  },
  "bugs": "https://github.com/oriebalzyuot96/orca-ui/issues",
  "author": "oriebalzyuot96",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
