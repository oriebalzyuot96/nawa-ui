---
// Site header: brand, main navigation (a sheet on small screens), search (⌘K), appearance popover,
// the Orca AccessibilityPanel, language switch and source link. Behaviour lives in src/scripts/site.ts.
import Icon from '@orca-ui/icons/astro';
import AccessibilityPanel from '@orca-ui/astro/components/AccessibilityPanel';
import Logo from './Logo.astro';
import { accents, mainNav, repo, t } from '../data/site';

interface Props {
  lang: 'en' | 'ar';
  /** Path of this page in the other language, without the base. */
  otherLangPath: string;
}

const { lang, otherLangPath } = Astro.props;
const L = t[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname;
const nav = mainNav(lang, base);
const isCurrent = (href: string, match?: string) => path === href || (match ? path.startsWith(match) : false);
const homeHref = lang === 'ar' ? `${base}/ar/` : `${base}/`;
const modes = ['system', 'light', 'dark', 'hc'] as const;
const modeIcon = { system: 'desktop', light: 'sun', dark: 'moon', hc: 'contrast' } as const;
const shapes = ['sharp', 'default', 'round'] as const;
---

<header class="site-header" data-site-header>
  <div class="container site-header__inner">
    <a class="brand" href={homeHref}>
      <Logo size={30} />
      <span class="brand__name">Orca UI</span>
      <span class="brand__ver" dir="ltr">v0.1</span>
    </a>

    <nav class="site-nav" id="site-nav" aria-label={L.mainNav} data-site-nav>
      <ul class="site-nav__list">
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href, item.match) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
      <div class="site-nav__extra">
        <a href={`${base}${otherLangPath}`} lang={lang === 'ar' ? 'en' : 'ar'} hreflang={lang === 'ar' ? 'en' : 'ar'}>
          <Icon name="language" size={18} />{L.otherLang}
        </a>
        <a href={repo} rel="noopener"><Icon name="code" size={18} />{L.source}</a>
      </div>
    </nav>

    <div class="header-tools">
      <button type="button" class="search-trigger" data-palette-open aria-haspopup="dialog" aria-keyshortcuts="Control+K Meta+K">
        <Icon name="search" size={17} />
        <span class="search-trigger__label">{L.searchDocs}</span>
        <kbd class="search-trigger__kbd" aria-hidden="true" data-kbd-mod>Ctrl K</kbd>
      </button>

      <div class="appearance" data-appearance>
        <button type="button" class="icon-btn" aria-expanded="false" aria-controls="appearance-panel" data-appearance-toggle>
          <Icon name="palette" size={19} variant="duotone" />
          <span class="oc-sr-only">{L.appearance}</span>
        </button>
        <div class="appearance__panel" id="appearance-panel" hidden data-appearance-panel>
          <p class="appearance__title" id="appearance-title">{L.appearance}</p>
          <fieldset class="appearance__group">
            <legend>{L.mode}</legend>
            <div class="appearance__modes">
              {modes.map((m) => (
                <label class="choice">
                  <input type="radio" name="site-mode" value={m} data-theme-choice="mode" />
                  <span class="choice__box"><Icon name={modeIcon[m]} size={18} />{L.modes[m]}</span>
                </label>
              ))}
            </div>
          </fieldset>
          <fieldset class="appearance__group">
            <legend>{L.accent}</legend>
            <div class="appearance__accents">
              {accents.map((a) => (
                <label class="swatch swatch--lg" data-accent={a} title={a}>
                  <input type="radio" class="oc-sr-only" name="site-accent" value={a} data-theme-choice="accent" />
                  <span class="swatch__dot" aria-hidden="true"></span>
                  <span class="oc-sr-only">{a}</span>
                </label>
              ))}
            </div>
          </fieldset>
          <fieldset class="appearance__group">
            <legend>{L.shape}</legend>
            <div class="appearance__shapes">
              {shapes.map((s) => (
                <label class="choice choice--shape">
                  <input type="radio" name="site-shape" value={s} data-theme-choice="shape" />
                  <span class="choice__box"><span class={`shape-glyph shape-glyph--${s}`} aria-hidden="true"></span>{L.shapes[s]}</span>
                </label>
              ))}
            </div>
          </fieldset>
          <div class="appearance__row">
            <span id="anim-label">{L.animations}</span>
            <button type="button" class="motion-toggle" role="switch" aria-checked="true" aria-labelledby="anim-label" data-motion-switch>
              <span class="motion-toggle__track" aria-hidden="true"><span class="motion-toggle__thumb"></span></span>
              <span aria-hidden="true" data-motion-state data-on={L.animOn} data-off={L.animPaused}>{L.animOn}</span>
            </button>
          </div>
        </div>
      </div>

      <div class="header-a11y">
        <AccessibilityPanel trigger="inline" locale={lang} id="site-a11y" triggerLabel={L.a11y} />
      </div>

      <a class="icon-btn header-only-wide" href={`${base}${otherLangPath}`} lang={lang === 'ar' ? 'en' : 'ar'} hreflang={lang === 'ar' ? 'en' : 'ar'}>
        <Icon name="language" size={19} />
        <span class="oc-sr-only">{L.otherLang}</span>
      </a>
      <a class="icon-btn header-only-wide" href={repo} rel="noopener">
        <Icon name="code" size={19} />
        <span class="oc-sr-only">{L.source}</span>
      </a>

      <button type="button" class="icon-btn menu-btn" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
        <Icon name="menu" size={20} class="menu-btn__open" />
        <Icon name="x" size={20} class="menu-btn__close" />
        <span class="oc-sr-only">{L.menu}</span>
      </button>
    </div>
  </div>
</header>
