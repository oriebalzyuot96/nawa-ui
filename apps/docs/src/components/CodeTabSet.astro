---
// WAI-ARIA tabs whose panels are code blocks, rendered from data (Astro slots can't be generated in a loop).
// Uses the Orca tabs styles; src/scripts/site.ts handles clicks and arrow keys for [data-site-tabs].
import CodeBlock from './CodeBlock.astro';

export interface CodeTab {
  key: string;
  label: string;
  code: string;
  lang: string;
  file?: string;
  langLabel?: string;
}

interface Props {
  items: CodeTab[];
  label: string;
  locale?: 'en' | 'ar';
  class?: string;
}

const { items, label, locale = 'en', class: className } = Astro.props;
const id = `ct-${Math.random().toString(36).slice(2, 8)}`;
---

<div class:list={['oc-tabs', 'code-tabset', className]} data-site-tabs>
  <div role="tablist" class="oc-tabs__list" aria-label={label}>
    {
      items.map((t, i) => (
        <button
          type="button"
          role="tab"
          id={`${id}-tab-${t.key}`}
          aria-controls={`${id}-panel-${t.key}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          class="oc-tabs__tab"
        >
          {t.label}
        </button>
      ))
    }
  </div>
  {
    items.map((t, i) => (
      <div role="tabpanel" id={`${id}-panel-${t.key}`} aria-labelledby={`${id}-tab-${t.key}`} class="oc-tabs__panel" hidden={i !== 0}>
        <CodeBlock code={t.code} lang={t.lang} file={t.file} lang_label={t.langLabel} locale={locale} />
      </div>
    ))
  }
</div>
