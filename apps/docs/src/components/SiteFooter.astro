---
import Icon from '@orca-ui/icons/astro';
import Logo from './Logo.astro';
import InstallCommand from './InstallCommand.astro';
import { categories } from '../data/catalog';
import { categoryIcon, repo } from '../data/site';
import { packageById } from '../data/packages';

interface Props {
  lang: 'en' | 'ar';
  otherLangPath: string;
}

const { lang, otherLangPath } = Astro.props;
const ar = lang === 'ar';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pk = ar ? `${base}/ar/packages/` : `${base}/packages/`;
const umbrella = packageById('orca-ui')!;

const columns = [
  {
    title: ar ? 'المنتج' : 'Product',
    links: [
      { href: ar ? `${base}/ar/` : `${base}/`, label: ar ? 'الرئيسية' : 'Home' },
      { href: `${base}/components/`, label: ar ? 'المكونات' : 'Components' },
      { href: pk, label: ar ? 'الحزم' : 'Packages' },
      { href: `${base}/themes/`, label: ar ? 'الثيمات' : 'Themes' },
      { href: `${base}/space/`, label: ar ? 'أوركا سبيس' : 'Orca Space' },
      { href: `${base}/getting-started/`, label: ar ? 'ابدأ' : 'Get started' },
    ],
  },
  {
    title: ar ? 'الحزم' : 'Packages',
    links: ['react', 'vue', 'angular', 'svelte', 'astro', 'react-native', 'flutter'].map((id) => {
      const p = packageById(id)!;
      return { href: `${pk}#${id}`, label: p.name, ltr: true };
    }),
  },
  {
    title: ar ? 'إمكانية الوصول' : 'Accessibility',
    links: [
      { href: `${base}/accessibility/`, label: ar ? 'الالتزام بـ WCAG' : 'WCAG commitment' },
      { href: `${base}/accessibility-modes/`, label: ar ? 'أوضاع العرض' : 'Display modes' },
      { href: `${base}/themes/#custom-brand`, label: ar ? 'ألوان العلامة' : 'Brand colors' },
    ],
  },
  {
    title: ar ? 'الموارد' : 'Resources',
    links: [
      { href: repo, label: 'GitHub', external: true },
      { href: 'https://www.npmjs.com/package/orca-ui', label: 'npm', external: true },
      { href: 'https://pub.dev/packages/orca_ui', label: 'pub.dev', external: true },
      { href: `${base}/llms.txt`, label: 'llms.txt' },
      { href: `${base}/sitemap-index.xml`, label: ar ? 'خريطة الموقع' : 'Sitemap' },
    ],
  },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a class="brand" href={ar ? `${base}/ar/` : `${base}/`}>
          <Logo size={34} />
          <span class="brand__name">Orca UI</span>
        </a>
        <p class="site-footer__pitch">
          {
            ar
              ? 'نظام تصميم واحد لسبع منصّات. سهل الوصول افتراضياً، مخصّص بالكامل، ومفتوح المصدر.'
              : 'One design system for seven platforms. Accessible by default, fully themeable, open source.'
          }
        </p>
        <InstallCommand options={umbrella.install} locale={lang} compact label={ar ? 'تثبيت orca-ui' : 'Install orca-ui'} />
      </div>
      <div class="site-footer__cols">
        {columns.map((col, i) => (
          <nav class="site-footer__col" aria-labelledby={`footer-col-${i}`}>
            <p class="site-footer__heading" id={`footer-col-${i}`}>{col.title}</p>
            <ul>
              {col.links.map((l) => (
                <li>
                  <a href={l.href} dir={'ltr' in l && l.ltr ? 'ltr' : undefined} rel={'external' in l && l.external ? 'noopener' : undefined}>
                    {l.label}
                    {'external' in l && l.external && <Icon name="external-link" size={13} flipRtl />}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))}
      </div>
    </div>

    <nav class="site-footer__cats" aria-label={ar ? 'صفحات المكونات' : 'Component pages'}>
      <ul>
        {categories.map((c) => (
          <li>
            <a href={`${base}/components/${c.slug}/`}><Icon name={categoryIcon[c.slug] ?? 'grid'} size={15} />{c.h1}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-footer__bottom">
      <span>© {new Date().getFullYear()} Orca UI · {ar ? 'رخصة MIT' : 'MIT License'}</span>
      <span class="site-footer__badges">
        <span class="pill"><Icon name="shield-check" size={14} />WCAG 2.2 AA</span>
        <span class="pill"><Icon name="language" size={14} />{ar ? 'يدعم RTL' : 'RTL ready'}</span>
      </span>
      <a href={`${base}${otherLangPath}`} lang={ar ? 'en' : 'ar'} hreflang={ar ? 'en' : 'ar'}>{ar ? 'English' : 'العربية'}</a>
    </div>
  </div>
</footer>
