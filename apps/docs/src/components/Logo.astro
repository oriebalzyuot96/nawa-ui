---
// Orca UI mark: an orca's dorsal fin rising from a wave. Uses theme tokens so it follows the active theme.
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---

<svg class="logo" width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <rect width="32" height="32" rx="9" fill="var(--oc-primary)"></rect>
  <path class="logo__fin" d="M9.5 21.5C11.2 15.4 14.6 9.6 20.6 6.8c-.9 4.6-.5 9.6 1.4 14.7z" fill="var(--oc-on-primary)"></path>
  <path class="logo__wave" d="M5.5 24.2c2.1-1.6 4.2-1.6 6.3 0s4.2 1.6 6.3 0 4.2-1.6 6.3 0 2.1 1.6 2.1 1.6" fill="none" stroke="var(--oc-on-primary)" stroke-width="2" stroke-linecap="round"></path>
</svg>
