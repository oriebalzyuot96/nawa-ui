---
// Nawa mark: a nucleus (نواة) with one orbit. Uses currentColor + primary so it follows the theme.
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <rect width="32" height="32" rx="9" fill="var(--nw-primary)"></rect>
  <ellipse cx="16" cy="16" rx="11" ry="5.2" fill="none" stroke="var(--nw-on-primary)" stroke-width="2" transform="rotate(-30 16 16)"></ellipse>
  <circle cx="16" cy="16" r="4.2" fill="var(--nw-on-primary)"></circle>
</svg>
