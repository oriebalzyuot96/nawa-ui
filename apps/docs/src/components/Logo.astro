---
// Pelagic UI mark: a drop of open sea with layered waves inside it, the lower layer fainter as the water deepens.
// Uses theme tokens so it follows the active theme.
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---

<svg class="logo" width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <rect width="32" height="32" rx="9" fill="var(--pl-primary)"></rect>
  <path class="logo__drop" d="M16 5c-4.1 5.1-7.6 9.7-7.6 13.9a7.6 7.6 0 0 0 15.2 0C23.6 14.7 20.1 10.1 16 5z" fill="var(--pl-on-primary)"></path>
  <g class="logo__waves" fill="none" stroke="var(--pl-primary)" stroke-width="1.7" stroke-linecap="round">
    <path d="M10.5 17.6q1.375-1.3 2.75 0t2.75 0 2.75 0 2.75 0"></path>
    <path d="M12 21.6q1.333-1.15 2.667 0t2.667 0 2.666 0" stroke-opacity="0.6"></path>
  </g>
</svg>
