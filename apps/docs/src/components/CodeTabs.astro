---
import CodeBlock from './CodeBlock.astro';
import CodeTabSet from './CodeTabSet.astro';
import { frameworks, type CodeSet } from '../data/snippets';

interface Props {
  code: CodeSet;
  label: string;
}

const { code, label } = Astro.props;
// Only show tabs for frameworks that actually ship this component.
const available = frameworks.filter((f) => code[f.key]);
const only = available.length === 1 ? available[0] : undefined;
---

{
  only ? (
    <div class="code-tabs code-tabs--single">
      <p class="code-tabs__label">
        <span class="oc-badge oc-badge--primary">{only.label}</span>
        {only.key === 'react' && <span class="muted">Coming to Vue, Svelte and Angular.</span>}
      </p>
      <CodeBlock code={code[only.key]!} lang={only.lang} file={`${label} · ${only.label}`} lang_label={only.lang.toUpperCase()} />
    </div>
  ) : (
    <div class="code-tabs">
      <CodeTabSet
        label={`${label} code examples`}
        items={available.map((f) => ({ key: f.key, label: f.label, code: code[f.key]!, lang: f.lang, file: `${label} · ${f.label}`, langLabel: f.lang.toUpperCase() }))}
      />
    </div>
  )
}
