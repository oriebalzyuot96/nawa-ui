---
import '@orca-ui/core/style.css';
import '@orca-ui/icons/css';
import '../styles/site.css';
import '../styles/chrome.css';
import '../styles/home.css';
import '../styles/packages.css';
import ThemeScript from '@orca-ui/astro/components/ThemeScript';
import Toaster from '@orca-ui/astro/components/Toaster';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CommandPalette from '../components/CommandPalette.astro';
import { repo, t } from '../data/site';

interface Props {
  title: string;
  description: string;
  lang?: 'en' | 'ar';
  /** Path of the equivalent page in the other language, for hreflang. */
  alternate?: { en?: string; ar?: string };
  /** Extra JSON-LD objects for this page. */
  structuredData?: Record<string, unknown>[];
}

const { title, description, lang = 'en', alternate, structuredData = [] } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(`${base}/og.png`, site).href;
const fullTitle = title.includes('Orca UI') ? title : `${title} — Orca UI`;
const isAr = lang === 'ar';
// Where the language switch goes: the translated page when there is one, otherwise the other home page.
const otherLangPath = (isAr ? alternate?.en : alternate?.ar) ?? (isAr ? '/' : '/ar/');

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareSourceCode',
    name: 'Orca UI',
    alternateName: ['orca-ui', 'أوركا UI'],
    description:
      'Accessible, themeable UI component library for React, Vue, Angular, Svelte, Astro, React Native and Flutter. WCAG 2.2 AA, 21 themes, custom brand colors, dark mode, high contrast, accessibility modes, charts, 3D, RTL.',
    url: new URL(`${base}/`, site).href,
    codeRepository: repo,
    programmingLanguage: ['TypeScript', 'CSS', 'Dart'],
    runtimePlatform: ['React', 'Vue', 'Angular', 'Svelte', 'Astro', 'React Native', 'Flutter'],
    license: 'https://opensource.org/licenses/MIT',
    keywords:
      'ui library, component library, design system, react, vue, angular, svelte, astro, react native, flutter, accessibility, wcag, themes, dark mode, skeleton, rtl, arabic',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Orca UI',
    url: new URL(`${base}/`, site).href,
    inLanguage: ['en', 'ar'],
  },
  ...structuredData,
];
---

<!doctype html>
<html lang={lang} dir={isAr ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#5b34d6" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    {alternate?.en && <link rel="alternate" hreflang="en" href={new URL(`${base}${alternate.en}`, site).href} />}
    {alternate?.ar && <link rel="alternate" hreflang="ar" href={new URL(`${base}${alternate.ar}`, site).href} />}
    {alternate?.en && <link rel="alternate" hreflang="x-default" href={new URL(`${base}${alternate.en}`, site).href} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Orca UI" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={isAr ? 'ar_AR' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <ThemeScript />
    {/* The site's own animation pause, restored before first paint. */}
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        if (localStorage.getItem('orca-docs-motion') === 'paused') document.documentElement.setAttribute('data-site-motion', 'paused');
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="oc-skip-link" href="#main">{t[lang].skip}</a>
    <SiteHeader lang={lang} otherLangPath={otherLangPath} />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <SiteFooter lang={lang} otherLangPath={otherLangPath} />
    <CommandPalette lang={lang} />
    <Toaster />
    <p class="oc-sr-only" role="status" aria-live="polite" data-site-live></p>

    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
