---
import Base from '../layouts/Base.astro';
import HomePage from '../components/HomePage.astro';
---

<Base
  title="Orca UI — Accessible UI component library for React, Vue, Angular, Svelte, Astro, React Native & Flutter"
  description="Orca UI is an open-source, accessible (WCAG 2.2 AA) UI component library shipped as native packages for React, Vue, Angular, Svelte, Astro, React Native and Flutter — 21 themes, custom brand colors, accessibility modes, charts, 3D, icons and RTL."
  alternate={{ en: '/', ar: '/ar/' }}
>
  <HomePage locale="en" />
</Base>
