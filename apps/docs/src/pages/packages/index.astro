---
import Base from '../../layouts/Base.astro';
import PackagesPage from '../../components/PackagesPage.astro';
import { packages } from '../../data/packages';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = Astro.site!;
const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Orca UI packages',
  itemListElement: packages.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'SoftwareSourceCode',
      name: p.name,
      description: p.description.en,
      url: new URL(`${base}/packages/#${p.id}`, site).href,
      codeRepository: p.sourceUrl,
      license: 'https://opensource.org/licenses/MIT',
    },
  })),
};
---

<Base
  title="Packages — install Orca UI for React, Vue, Angular, Svelte, Astro, React Native and Flutter"
  description="Every Orca UI package in one place: orca-ui, @orca-ui/react, vue, angular, svelte, astro, react-native, three, icons, illustrations, core and orca_ui for Flutter — install commands, imports, export paths and sizes."
  alternate={{ en: '/packages/', ar: '/ar/packages/' }}
  structuredData={[itemList]}
>
  <PackagesPage locale="en" />
</Base>
