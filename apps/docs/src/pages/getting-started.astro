---
import Base from '../layouts/Base.astro';
import CodeTabs from '../components/CodeTabs.astro';
import { install, snippets } from '../data/snippets';
import Alert from '@orca-ui/astro/components/Alert';
---

<Base
  title="Get started"
  description="Install Orca UI in React, Vue, Svelte, Astro or React Native in under a minute: one package, one stylesheet import, and 21 accessible themes."
>
  <section class="section">
    <div class="container" style="max-width:52rem">
      <p class="eyebrow">Get started</p>
      <h1>Install Orca UI</h1>
      <p class="lead">One package for your framework plus <code>@orca-ui/core</code> for the styles and tokens.</p>

      <h2 style="margin-top:2rem">1. Install and import the styles</h2>
      <CodeTabs label="Install" code={install} />

      <h2 style="margin-top:2rem">2. Use a component</h2>
      <CodeTabs label="Button" code={snippets.button} />

      <h2 style="margin-top:2rem">3. Pick a theme</h2>
      <p class="muted">By default Orca UI follows the operating system: light, dark, or high contrast. Override it any time.</p>
      <CodeTabs label="Theme" code={snippets.theme} />

      <div style="margin-top:2rem">
        <Alert variant="info" title="Right-to-left">Set <code>dir="rtl"</code> on <code>&lt;html&gt;</code> and every component mirrors automatically.</Alert>
      </div>
    </div>
  </section>
</Base>
