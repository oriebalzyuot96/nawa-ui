---
import Base from '../layouts/Base.astro';
import CodeTabs from '../components/CodeTabs.astro';
import { install, snippets } from '../data/snippets';
import Alert from '@pelagic-ui/astro/components/Alert';
---

<Base
  title="Get started"
  description="Install Pelagic UI in React, Vue, Svelte, Astro or React Native in under a minute: one package, one stylesheet import, and 21 accessible themes."
>
  <section class="section">
    <div class="container" style="max-width:52rem">
      <p class="eyebrow">Get started</p>
      <h1>Install Pelagic UI</h1>
      <p class="lead">One package for your framework plus <code>@pelagic-ui/core</code> for the styles and tokens.</p>

      <h2 style="margin-top:2rem">1. Install and import the styles</h2>
      <CodeTabs label="Install" code={install} />

      <h2 style="margin-top:2rem">2. Use a component</h2>
      <CodeTabs label="Button" code={snippets.button} />

      <h2 style="margin-top:2rem">3. Supported versions</h2>
      <table>
        <thead><tr><th scope="col">Framework</th><th scope="col">Supported versions</th></tr></thead>
        <tbody>
          <tr><th scope="row">React</th><td>18 and 19</td></tr>
          <tr><th scope="row">Vue</th><td>3.4 and up</td></tr>
          <tr><th scope="row">Angular</th><td>20, 21 and 22</td></tr>
          <tr><th scope="row">Svelte</th><td>5</td></tr>
          <tr><th scope="row">Astro</th><td>5 (the <code>@pelagic-ui/astro</code> package)</td></tr>
          <tr><th scope="row">React Native</th><td>0.74 and up, including Expo</td></tr>
          <tr><th scope="row">Three.js (3D)</th><td>0.160 and up</td></tr>
          <tr><th scope="row">Flutter</th><td>The <code>pelagic_ui</code> package on pub.dev</td></tr>
        </tbody>
      </table>

      <h2 style="margin-top:2rem">4. Pick a theme</h2>
      <p class="muted">By default Pelagic UI follows the operating system: light, dark, or high contrast. Override it any time.</p>
      <CodeTabs label="Theme" code={snippets.theme} />

      <div style="margin-top:2rem">
        <Alert variant="info" title="Right-to-left">Set <code>dir="rtl"</code> on <code>&lt;html&gt;</code> and every component mirrors automatically.</Alert>
      </div>
    </div>
  </section>
</Base>
