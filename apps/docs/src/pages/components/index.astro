---
import DocsLayout from '../../layouts/DocsLayout.astro';
import CodeTabs from '../../components/CodeTabs.astro';
import { snippets } from '../../data/snippets';
import { categories, documentedCount } from '../../data/catalog';
import { categoryIcon } from '../../data/site';
import Icon from '@pelagic-ui/icons/astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<DocsLayout
  title="Components — every Pelagic UI component with live demos"
  description={`All ${documentedCount} Pelagic UI components grouped by category: forms, advanced inputs, data, panels, overlays, menus, media, feedback, charts, 3D and motion — each with a live demo, props and accessible code.`}
>
  <h1>Components</h1>
  <p class="lead">
    {documentedCount} accessible components in {categories.length} categories. Each page has live demos, a props summary, keyboard support and code
    you can copy. Change the theme from the header — every demo follows.
  </p>

  <div class="category-grid">
    {
      categories.map((c) => (
        <section class="category-card" aria-labelledby={`cat-${c.slug}`}>
          <h2 id={`cat-${c.slug}`}>
            <a href={`${base}/components/${c.slug}/`}>
              <span class="category-card__icon"><Icon name={categoryIcon[c.slug] ?? 'grid'} size={20} variant="duotone" /></span> {c.h1}
            </a>
          </h2>
          <p class="muted">{c.entries.length} components</p>
          <ul class="category-card__list">
            {c.entries.map((e) => (
              <li>
                <a href={`${base}/components/${c.slug}/#${e.id}`}>{e.name}</a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <section class="doc" aria-labelledby="h-theming">
    <h2 id="h-theming">Theming in code</h2>
    <p class="muted">Every component reads the same design tokens. Switch mode, accent and shape at runtime or scope a theme to one section.</p>
    <CodeTabs label="Theme" code={snippets.theme!} />
  </section>
</DocsLayout>
