---
import Base from '../../layouts/Base.astro';
import Playground from '../../components/Playground';
import Badge from '@orca-ui/astro/components/Badge';
import Alert from '@orca-ui/astro/components/Alert';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const features = [
  { icon: '♿', title: 'سهولة الوصول أولاً', text: 'متوافقة مع WCAG 2.2 AA: ‏525 فحص تباين آلي، حبس التركيز في النوافذ، تنقّل كامل بلوحة المفاتيح، ودعم قارئات الشاشة.' },
  { icon: '🎨', title: '21 ثيم و3 أشكال', text: 'فاتح وداكن وتباين عالٍ مع سبعة ألوان. غيّر الثيم بسطر واحد أو اتبع إعدادات النظام تلقائياً.' },
  { icon: '⚡', title: 'تصميم واحد لخمسة أطر', text: 'React وVue وSvelte وAstro وReact Native بنفس الأسماء والسلوك. تعلّم مرة واحدة واستخدمها في كل مكان.' },
  { icon: '🦴', title: 'هياكل تحميل جاهزة', text: 'Skeleton للنصوص والبطاقات والجداول، يُعلن عنها لقارئ الشاشة مرة واحدة فقط.' },
  { icon: '📊', title: 'جاهزة للبيانات', text: 'جدول بيانات قابل للترتيب، ترقيم صفحات، تبويبات، نوافذ، إشعارات، ومراحل — أساسيات PrimeNG.' },
  { icon: '🌍', title: 'دعم كامل للعربية', text: 'خصائص CSS منطقية في كل مكان، فتنعكس الواجهة تلقائياً من اليمين لليسار.' },
];
---

<Base
  lang="ar"
  title="Orca UI — مكتبة واجهات مستخدم عربية سهلة الوصول لـ React وVue وSvelte وAstro وReact Native"
  description="أوركا UI (Orca UI) مكتبة مكونات واجهات مستخدم مفتوحة المصدر، سهلة الوصول (WCAG 2.2 AA)، مع 21 ثيم ووضع داكن وتباين عالٍ وهياكل تحميل ودعم كامل للعربية RTL، لـ React وVue وSvelte وAstro وReact Native."
  alternate={{ en: '/', ar: '/ar/' }}
>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">مكتبة واجهات مفتوحة المصدر</p>
      <h1>أوركا UI — مكتبة مكونات واجهات المستخدم لكل الأطر</h1>
      <p class="lead">
        مكونات جميلة وقابلة للتخصيص لـ <strong>React وVue وSvelte وAstro وReact Native</strong>. سهلة الوصول افتراضياً، مع 21 ثيم جاهز ونفس
        الواجهة البرمجية في كل مكان، ودعم كامل للغة العربية.
      </p>
      <div class="framework-row">
        {['React', 'Vue', 'Svelte', 'Astro', 'React Native'].map((f) => <Badge variant="primary">{f}</Badge>)}
      </div>
      <div class="hero__actions">
        <a class="oc-btn oc-btn--primary oc-btn--lg" href={`${base}/getting-started/`}>ابدأ الآن</a>
        <a class="oc-btn oc-btn--secondary oc-btn--lg" href={`${base}/components/`}>تصفّح المكونات</a>
      </div>
      <div class="install" dir="ltr"><span aria-hidden="true">$</span><code>npm i @orca-ui/react @orca-ui/core</code></div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="ar-playground">
    <div class="container">
      <p class="eyebrow">معاينة مباشرة</p>
      <h2 id="ar-playground">جرّبها الآن — تطبيق حقيقي مبني بأوركا UI</h2>
      <p class="lead">ابحث، صفِّ، رتّب، أضف عضواً، وشغّل هياكل التحميل. غيّر الثيم من الأعلى وشاهد التحديث فوراً.</p>
      <Playground client:visible />
    </div>
  </section>

  <section class="section" aria-labelledby="ar-features">
    <div class="container">
      <h2 id="ar-features">لماذا أوركا UI؟</h2>
      <div class="grid grid--3" style="margin-top:1.5rem">
        {features.map((f) => (
          <article class="feature">
            <h3><span aria-hidden="true">{f.icon}</span>{f.title}</h3>
            <p>{f.text}</p>
          </article>
        ))}
      </div>
      <div style="margin-top:1.5rem">
        <Alert variant="success" title="مجانية ومفتوحة المصدر">مرخّصة بـ MIT، استخدمها في المشاريع الشخصية والتجارية.</Alert>
      </div>
    </div>
  </section>
</Base>
